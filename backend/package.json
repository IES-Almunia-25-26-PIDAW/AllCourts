{
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate:up": "dotenv -e ./.env -- db-migrate up --config ./src/db/database.json --migrations-dir ./src/db/migrations",
    "migrate:down": "dotenv -e ./.env -- db-migrate down --config ./src/db/database.json --migrations-dir ./src/db/migrations",
    "migrate:status": "dotenv -e ./.env -- db-migrate check --config ./src/db/database.json --migrations-dir ./src/db/migrations",
    "migrate:create": "dotenv -e ./.env -- db-migrate create --config ./src/db/database.json --migrations-dir ./src/db/migrations",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "db-migrate": "^0.11.14",
    "db-migrate-mysql": "^3.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.15.3",
    "nodemailer": "^8.0.2",
    "express-rate-limit": "^7.5.0",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "nodemon": "^3.1.14"
  }
}
